{
  "name": "permsift",
  "version": "0.12.0",
  "description": "Test tasks. Trim permissions. Evidence-driven sandbox policy experiments.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "permsift": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/test/integration/*.test.js",
    "check": "tsc --noEmit",
    "demo": "npm run build && node dist/cli.js tighten --config examples/demo/permsift.yaml --limits examples/limits.json",
    "examples:prepare": "node scripts/prepare-examples.mjs",
    "examples:verify": "npm run build && node scripts/verify-examples.mjs",
    "self:verify": "npm run build && node dist/cli.js tighten --config examples/self-build.yaml --limits examples/limits.json",
    "demo:read": "npm run build && node dist/cli.js tighten --config examples/demo/read-permsift.yaml --limits examples/read-limits.json",
    "third-party:prepare": "node scripts/prepare-clsx.mjs",
    "third-party:verify": "npm run build && node scripts/verify-clsx.mjs",
    "regression:prepare": "node scripts/prepare-regression.mjs",
    "regression:verify": "npm run build && node scripts/verify-regression.mjs",
    "install:verify": "npm run build && node scripts/verify-install.mjs",
    "stages:verify": "npm run build && node scripts/verify-stages.mjs",
    "medium:prepare": "node scripts/prepare-fast-glob.mjs",
    "medium:verify": "npm run build && node scripts/verify-fast-glob.mjs",
    "hashes:benchmark": "npm run build && node scripts/benchmark-hashes.mjs",
    "search:benchmark": "npm run build && node scripts/compare-search-budget.mjs",
    "observe:verify": "npm run build && node scripts/verify-observation.mjs",
    "compile:verify": "npm run build && node scripts/verify-compilation.mjs",
    "bundle:prepare": "node scripts/prepare-bundling.mjs",
    "bundle:verify": "npm run build && node scripts/verify-bundling.mjs",
    "offline:verify": "npm run build && node scripts/verify-offline.mjs",
    "model:verify": "npm run build && node scripts/verify-model.mjs",
    "environment:verify": "npm run build && node scripts/verify-environment.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "fast-xml-parser": "5.11.2",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
