{
  "name": "permsift",
  "version": "0.1.0",
  "description": "Test tasks. Trim permissions. Evidence-driven sandbox policy experiments.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "permsift": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/test/integration/*.test.js",
    "check": "tsc --noEmit",
    "demo": "npm run build && node dist/cli.js tighten --config examples/demo/permsift.yaml --limits examples/limits.json"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
